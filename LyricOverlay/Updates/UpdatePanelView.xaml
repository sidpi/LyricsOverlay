<UserControl x:Class="LyricOverlay.Updates.UpdatePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#E8FFFFFF" />
        <SolidColorBrush x:Key="MutedText" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="SubtleText" Color="#57FFFFFF" />
        <SolidColorBrush x:Key="FaintText" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="Amber" Color="#EA7B24" />
        <SolidColorBrush x:Key="AmberSoft" Color="#F5A35C" />

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9EFFFFFF" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="10"
                                Background="#12FFFFFF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2BFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#160D05" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="#EA7B24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270"
                                                  Opacity="0.45" Color="#EA7B24" />
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F08A38" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D96C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#73FFFFFF" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F2FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.25" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#3DFFFFFF" Margin="1,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Room for the drop shadow; the card keeps the translucent charcoal surface. -->
    <Border x:Name="Card"
            Width="356"
            Margin="30"
            CornerRadius="18"
            Background="#F2141618"
            BorderBrush="{StaticResource Hairline}"
            BorderThickness="1"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.58" Color="#000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="EnterScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="EnterShift" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>1,1</Border.RenderTransformOrigin>

        <StackPanel>
            <Grid Margin="16,14,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="SOFTWARE UPDATE"
                               FontSize="10.5"
                               Foreground="#6BFFFFFF" />
                    <TextBlock x:Name="Title"
                               Margin="0,4,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Subtitle"
                               Margin="0,2,0,0"
                               FontSize="10.5"
                               Foreground="{StaticResource SubtleText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        VerticalAlignment="Top"
                        ToolTip="Close">
                    <Path Data="M5 5 L13 13 M13 5 L5 13"
                          Stroke="#8CFFFFFF"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="18"
                          Height="18"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <Grid x:Name="BodyHost" Margin="16,0,16,16">
                <!-- Idle -->
                <Grid x:Name="IdlePanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Check GitHub Releases for a newer build."
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedText}" />
                    <Button x:Name="CheckButton"
                            Grid.Column="1"
                            Content="Check"
                            Style="{StaticResource GhostButton}" />
                </Grid>

                <!-- Checking -->
                <Grid x:Name="CheckingPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36">
                        <Ellipse Width="30" Height="30" Stroke="#47EA7B24" StrokeThickness="2" />
                        <Path Data="M18,3 A15,15 0 0 1 33,18"
                              Stroke="{StaticResource Amber}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Looking for a newer build…"
                                   FontSize="12.5"
                                   Foreground="#D9FFFFFF" />
                        <TextBlock Text="This only takes a moment."
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="#5CFFFFFF" />
                    </StackPanel>
                </Grid>

                <!-- Up to date -->
                <StackPanel x:Name="UpToDatePanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="36" Height="36">
                            <Ellipse Width="36" Height="36" Fill="#1F1DB954" />
                            <Viewbox Width="16" Height="16">
                                <Path Data="M20 6 L9 17 L4 12"
                                      Stroke="#1DB954"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Grid>
                        <TextBlock x:Name="UpToDateText"
                                   Margin="12,0,0,0"
                                   MaxWidth="244"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Foreground="#E0FFFFFF" />
                    </StackPanel>
                    <Button x:Name="UpToDateCheckButton"
                            Content="Check again"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0"
                            Style="{StaticResource GhostButton}" />
                </StackPanel>

                <!-- Update available -->
                <StackPanel x:Name="AvailablePanel" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border CornerRadius="99" Background="#12FFFFFF" Padding="8,3">
                                <TextBlock x:Name="FromChip"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#73FFFFFF" />
                            </Border>
                            <TextBlock Text="→"
                                       Margin="6,0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#40FFFFFF" />
                            <Border CornerRadius="99" Background="#26EA7B24" Padding="8,3">
                                <TextBlock x:Name="ToChip"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AmberSoft}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="PublishedText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#47FFFFFF" />
                    </Grid>

                    <ScrollViewer MaxHeight="148"
                                  Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <TextBlock x:Name="NotesText"
                                   Padding="0,0,4,0"
                                   FontSize="11.5"
                                   LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap"
                                   Foreground="#85FFFFFF" />
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="UpdateNowButton"
                                Content="Update Now"
                                MinWidth="130"
                                Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="LaterButton"
                                Content="Later"
                                Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </StackPanel>

                <!-- Downloading -->
                <StackPanel x:Name="DownloadingPanel" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock x:Name="PercentText"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" />
                            <TextBlock Text="%"
                                       Margin="1,0,0,3"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#66FFFFFF" />
                        </StackPanel>
                        <TextBlock x:Name="SizeText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"
                                   FontSize="10.5"
                                   Foreground="#66FFFFFF" />
                    </Grid>

                    <Border Height="6"
                            Margin="0,10,0,0"
                            CornerRadius="3"
                            Background="#17FFFFFF"
                            ClipToBounds="True">
                        <Grid>
                            <Border CornerRadius="3" HorizontalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#EA7B24" Offset="0" />
                                        <GradientStop Color="#F5A35C" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BarFillScale" ScaleX="0" />
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>0,0.5</Border.RenderTransformOrigin>
                            </Border>
                            <Rectangle Width="120" HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#52FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="BarShimmerShift" X="-160" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="SpeedText"
                                   HorizontalAlignment="Left"
                                   FontSize="10.5"
                                   Foreground="#61FFFFFF" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                HorizontalAlignment="Right"
                                Style="{StaticResource LinkButton}" />
                    </Grid>
                </StackPanel>

                <!-- Installing -->
                <StackPanel x:Name="InstallingPanel" Visibility="Collapsed">
                    <Border Height="6"
                            CornerRadius="3"
                            Background="#17FFFFFF"
                            ClipToBounds="True">
                        <Grid>
                            <Rectangle Width="120" HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#52FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="InstallShimmerShift" X="-160" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="Verifying signature &amp; installing update…"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#D9FFFFFF" />
                        <Ellipse x:Name="PulseDot"
                                 Width="6"
                                 Height="6"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource Amber}" />
                    </Grid>
                    <TextBlock Text="Keep LyricsOverlay open — closing is disabled until it finishes."
                               Margin="0,6,0,0"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Foreground="#52FFFFFF" />
                </StackPanel>

                <!-- Restarting -->
                <Grid x:Name="RestartingPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36">
                        <Ellipse Width="36" Height="36" Fill="#1FEA7B24" />
                        <Viewbox Width="16" Height="16">
                            <Path Data="M20 6 L9 17 L4 12"
                                  Stroke="{StaticResource Amber}"
                                  StrokeThickness="2.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Update installed — restarting…"
                                   FontSize="12.5"
                                   Foreground="#E0FFFFFF" />
                        <TextBlock x:Name="RestartingText"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="#5CFFFFFF" />
                    </StackPanel>
                </Grid>

                <!-- Error -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <Border CornerRadius="11" Background="#14E5484D" BorderBrush="#33E5484D" BorderThickness="1"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠"
                                       Margin="0,1,8,0"
                                       VerticalAlignment="Top"
                                       FontSize="12"
                                       Foreground="#F06065" />
                            <TextBlock x:Name="ErrorText"
                                       Grid.Column="1"
                                       FontSize="11.5"
                                       LineHeight="17"
                                       LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap"
                                       Foreground="#B3FFFFFF" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ErrorHint"
                               Margin="0,8,0,0"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Foreground="#4DFFFFFF" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RetryButton"
                                Content="Retry"
                                MinWidth="96"
                                Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="ErrorDismissButton"
                                Content="Dismiss"
                                Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
