<Window x:Class="LyricOverlay.Updates.UpdatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:LyricOverlay.Updates"
        Title="Update panel preview"
        Width="800"
        Height="700"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="DebugButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="#1B1D22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#272B32" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#323742" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <updates:UpdatePanelView x:Name="Panel"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Left" />

        <ScrollViewer Grid.Column="1" Margin="0,22,24,22" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Update panel preview"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#F2FFFFFF" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="#8E8E93"
                           Text="Mock mode: no GitHub call, no download, no install. These buttons drive the same controller the tray uses, so the panel's layout and motion are exactly what ships." />

                <TextBlock Text="STATES"
                           Margin="0,22,0,8"
                           FontSize="10.5"
                           Foreground="#6BFFFFFF" />
                <WrapPanel>
                    <Button Style="{StaticResource DebugButton}" Content="Idle" Tag="Idle" Click="OnPreviewClick" />
                    <Button Style="{StaticResource DebugButton}" Content="Checking" Tag="Checking" Click="OnPreviewClick" />
                    <Button Style="{StaticResource DebugButton}" Content="Up to date" Tag="UpToDate" Click="OnPreviewClick" />
                    <Button Style="{StaticResource DebugButton}" Content="Available" Tag="Available" Click="OnPreviewClick" />
                    <Button Style="{StaticResource DebugButton}" Content="Downloading" Tag="Downloading" Click="OnPreviewClick" />
                    <Button Style="{StaticResource DebugButton}" Content="Installing" Tag="Installing" Click="OnPreviewClick" />
                    <Button Style="{StaticResource DebugButton}" Content="Restarting" Tag="Restarting" Click="OnPreviewClick" />
                    <Button Style="{StaticResource DebugButton}" Content="Error" Tag="Error" Click="OnPreviewClick" />
                </WrapPanel>

                <TextBlock Text="FLOW"
                           Margin="0,18,0,8"
                           FontSize="10.5"
                           Foreground="#6BFFFFFF" />
                <WrapPanel>
                    <Button Style="{StaticResource DebugButton}" Content="Run full mock update" Click="OnRunFlow" />
                    <Button Style="{StaticResource DebugButton}" Content="Replay entrance" Click="OnReplay" />
                </WrapPanel>

                <Border Margin="0,26,0,0"
                        Padding="14"
                        CornerRadius="10"
                        Background="#121417"
                        BorderBrush="#1C1F24"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Shipping updater"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#D9FFFFFF" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11.5"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="#8E8E93"
                                   Text="The tray's “Check for updates…” opens this panel against https://api.github.com/repos/sidpi/LyricsOverlay/releases/latest. Set LYRICOVERLAY_UPDATE_MOCK=1 to use the simulated backend from the tray instead, or launch LyricOverlay.exe --update-preview to reopen this window." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
